# Optional. The default quick tunnel needs neither an account nor a token.
# CLOUDFLARED_PATH=C:\tools\cloudflared.exe
# TUNNEL_PORT=4318
# NGROK_PATH=C:\tools\ngrok.exe

# Durable Cloudflare tunnel: configure its public hostname service to
# http://127.0.0.1:4318 in the Cloudflare dashboard, NEVER to port 3000.
# PUBLIC_BASE_URL=https://rss.your-domain.example
# TUNNEL_TOKEN=your-secret-token
